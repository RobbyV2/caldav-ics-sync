# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=6765
PORT=6766
SERVER_PROXY_URL=http://localhost:6766

# Data directory for SQLite database
DATA_DIR=./data
# Full path to SQLite database (overrides DATA_DIR/caldav-sync.db)
# DB_PATH=./data/caldav-sync.db

# Rate limiting for /api and /ics (optional, disabled unless RATE_LIMIT_PER_SECOND is set)
# The proxied frontend assets are never rate limited.
# RATE_LIMIT_PER_SECOND=10
# RATE_LIMIT_BURST=60
# Key clients by X-Forwarded-For / X-Real-IP instead of the peer address. Required behind
# a reverse proxy, where all requests otherwise share the proxy's IP and one bucket.
# Only enable with a trusted proxy in front: clients can forge these headers.
# RATE_LIMIT_TRUST_PROXY=false

# Point the web UI at a backend on another origin (default: same origin)
# NEXT_PUBLIC_API_URL=https://sync.example.com

# Authentication (optional, requires AUTH_USERNAME + one password option)
# AUTH_USERNAME=admin
# AUTH_PASSWORD=changeme
# AUTH_PASSWORD_HASH=$argon2id$v=19$m=19456,t=2,p=1$...
